    <parent link="world"/>
    <child link="link_base"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <material name="black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>
  <material name="Red">
