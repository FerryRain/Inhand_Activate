<?xml version="1.0" encoding="utf-8"?>
<!-- =================================================================================== -->
<!-- | This URDF file combines the xArm6 robot with a Leap Hand as the end-effector.   | -->
<!-- | The Leap Hand definition now includes the FSR sensors.                         | -->
<!-- =================================================================================== -->
<robot name="xarm6_leap_hand_with_fsr">

