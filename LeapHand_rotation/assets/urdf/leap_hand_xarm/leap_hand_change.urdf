  <!-- |           CONNECTING XARM6 TO LEAP HAND (CRITICAL PART)                   | -->
  <!-- ============================================================================= -->
  <joint name="leap_hand_mount_joint" type="fixed">
    <!-- PARENT: The last link of the xArm -->
    <parent link="link6"/>
    <!-- CHILD: The base link of the Leap Hand -->
    <child link="onshape_palm_lower"/>
    <!-- 
      IMPORTANT: The origin (xyz and rpy) defines the mounting pose of the hand. 
      You MUST adjust these values to match your physical setup or simulation.
      The values below are a default starting point (no rotation, no offset).
    -->
    <origin xyz="0.03 0.06 0.012" rpy="0 -3.1415 -1.57"/>
  </joint>

